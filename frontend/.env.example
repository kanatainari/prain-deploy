# ─── Prain Frontend 환경변수 (.env.example) ──────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 실제 값을 입력하세요.
# 절대로 실제 Secret을 이 파일에 커밋하지 마세요.

# ─── 배포 ─────────────────────────────────────────────────────────────────────
# Backend API URL (Render 배포 시 백엔드 서비스 URL 설정)
BACKEND_URL=https://your-backend.onrender.com
VITE_BACKEND_URL=https://your-backend.onrender.com

# 서버 포트 (Render가 자동으로 PORT 환경변수를 제공합니다)
PORT=3000

# 프론트엔드 공개 URL (Discord redirect 등에 사용)
PRAIN_APP_URL=https://your-frontend.onrender.com

# ─── Discord ──────────────────────────────────────────────────────────────────
VITE_DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_ID=your-discord-application-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_BOT_TOKEN=your-discord-bot-token
