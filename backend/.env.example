# ─── Prain Backend 환경변수 (.env.example) ───────────────────────────────────
# 이 파일을 .env 로 복사한 뒤 실제 값을 입력하세요.
# 절대로 실제 Secret/Key를 이 파일에 커밋하지 마세요.

# ─── 배포 ─────────────────────────────────────────────────────────────────────
# 프론트엔드 URL (CORS 허용 대상). 쉼표로 여러 도메인 허용 가능.
FRONTEND_URL=https://your-frontend.onrender.com

# 백엔드 공개 URL (OAuth redirect 기준)
BACKEND_PUBLIC_URL=https://your-backend.onrender.com

# ─── 데이터베이스 ─────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./prain.db

# ─── 보안 ─────────────────────────────────────────────────────────────────────
SECRET_KEY=your-random-secret-key-here
TOKEN_ENCRYPTION_KEY=your-base64-fernet-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# ─── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ─── Discord OAuth ────────────────────────────────────────────────────────────
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret
DISCORD_REDIRECT_URI=https://your-backend.onrender.com/api/v1/integrations/discord/callback

# ─── Figma ────────────────────────────────────────────────────────────────────
FIGMA_CLIENT_ID=your-figma-client-id
FIGMA_CLIENT_SECRET=your-figma-client-secret
FIGMA_REDIRECT_URI=https://your-backend.onrender.com/api/v1/integrations/figma/callback

# ─── GitHub OAuth ─────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=https://your-backend.onrender.com/api/v1/integrations/github/callback

# ─── Notion OAuth ─────────────────────────────────────────────────────────────
NOTION_CLIENT_ID=your-notion-client-id
NOTION_CLIENT_SECRET=your-notion-client-secret
NOTION_REDIRECT_URI=https://your-backend.onrender.com/api/v1/integrations/notion/callback
